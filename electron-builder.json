{
  "appId": "com.objector.app",
  "productName": "Objector",
  "directories": {
    "output": "dist/nsis-build"
  },
  "asar": true,
  "asarUnpack": [
    "Objector2.ico",
    "Objector.ico",
    "native/app-runtime/build/Release/app_runtime.node"
  ],
  "files": [
    "src/**/*",
    "editor/**/*",
    "interpreter/**/*",
    "icons/**/*",
    "docs/**/*",
    "sounds/**/*",
    "examples/**/*",
    "extensions/**/*",
    "microbit-firmware/**/*",
    "native/app-runtime/build/Release/app_runtime.node",
    "package.json",
    "Objector.ico",
    "Objector.png",
    "Objector.svg",
    "Objector2.ico",
    "Objector2.png",
    "Objector2.svg",
    "Objector2.icns",
    "Objector2_1024.png",
    "ObjectorLoadImage.svg",
    "我的世界.png",
    "installer.nsh",
    "!out/**/*",
    "!dist/**/*",
    "!build/**/*",
    "!proj/**/*",
    "!tests/**/*",
    "!宣传片/**/*",
    "!服务器/**/*",
    "!objector-mc-addon/**/*",
    "!objector-netease-mod/**/*",
    "!sb3-file-source/**/*",
    "!.npm-temp/**/*",
    "!buildtemp/**/*"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "zip",
        "arch": ["x64"]
      }
    ],
    "icon": "Objector2.ico",
    "forceCodeSigning": false
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "installerIcon": "Objector2.ico",
    "uninstallerIcon": "Objector2.ico",
    "installerHeaderIcon": "Objector2.ico",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Objector",
    "artifactName": "Objector-Setup-${version}.${ext}",
    "include": "installer.nsh"
  },
  "linux": {
    "target": [
      {
        "target": "tar.gz",
        "arch": ["x64"]
      }
    ],
    "icon": "Objector2.png",
    "category": "Development"
  }
}
